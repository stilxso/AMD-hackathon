# ─── AirQ Backend Environment Variables ───
# Copy this file to .env and fill in your API tokens.
# All tokens are free-tier. Links below.

# WAQI (World Air Quality Index) — https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=your_waqi_token_here

# OpenAQ v3 — https://explore.openaq.org/register
OPENAQ_API_KEY=your_openaq_key_here

# OpenWeatherMap — https://openweathermap.org/api
# Powers both the weather context and the Air Pollution model source.
OPENWEATHER_API_KEY=your_openweather_key_here

# IQAir AirVisual — https://dashboard.iqair.com/personal/api-keys
# Nearest-city AQI from IQAir's monitor network. The free "Community" plan
# allows 5 calls/minute and 10k/month, so this source is cached on a coarser
# cell than the others. Leave blank and it reports "disabled".
IQAIR_API_KEY=

# Mapbox — https://account.mapbox.com/access-tokens/
# Powers /api/v1/route, the clean-air path builder. The same public pk. token
# the frontend map uses works here. Leave blank and that endpoint returns 503.
MAPBOX_TOKEN=

# Open-Meteo (CAMS global model) needs no key and is always enabled. It is what
# provides air quality data in areas with no physical monitoring station, and
# also the modelled grid that /stations returns as the map's density field.

# Gemini — https://aistudio.google.com/apikey
# Powers /api/v1/explain, the reasoned "why is pollution at this level" answer.
# Leave blank and that endpoint returns 503; nothing else is affected.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ─── Model Config ───
MODEL_PATH=fineweights.pt


PM25_CALIBRATION_DIVISOR=5.0
PM25_MAX=350.0

# Monte-Carlo dropout passes used to measure model uncertainty (only the small
# regression head is re-run, so this is cheap).
MC_DROPOUT_SAMPLES=20

# ─── Auth ───
# HS256 signing key for access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave blank and the server generates a random key per process — fine locally,
# but every restart signs users out.
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# SQLite file holding user accounts, relative to backend/.
DB_PATH=airq.db


DEMO_USERNAME=admin
DEMO_PASSWORD=doniponi228

# Comma-separated usernames that get the admin location override panel.
# Blank falls back to DEMO_USERNAME.
ADMIN_USERNAMES=

# ─── Server Config ───
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
MAX_UPLOAD_BYTES=10485760


CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001
